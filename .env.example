# Copy to .env and fill in. AWS credentials come from your normal AWS profile/SSO.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Any Bedrock model / inference profile you have access to
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Dataset: leave DATA_PATH empty to use the built-in synthetic auto-loan data.
# Otherwise point to your CSV and name the binary (0/1) target column.
DATA_PATH=
TARGET_COLUMN=default
